<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Scripting\MineClaw.Scripting.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
    <!-- Hive script spawns (semi-sleep clone runner, hive tool policy) run on the same in-memory bot. -->
    <ProjectReference Include="..\..\src\MineClaw.Hive\MineClaw.Hive.csproj" />
    <!-- Reuse the Bot tests' in-memory IGameClient/NoLlm/TestBot without referencing that project. -->
    <Compile Include="..\MineClaw.Bot.Tests\TestSupport.cs" Link="Linked\BotTestSupport.cs" />
  </ItemGroup>

</Project>
