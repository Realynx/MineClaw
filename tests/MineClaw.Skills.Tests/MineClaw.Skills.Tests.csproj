<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS8618;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\MineClaw.Sim\MineClaw.Sim.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.Skills\MineClaw.Skills.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
    <!-- Reuse the Bot tests' in-memory IGameClient/NoLlm without referencing that project (it pulls tools/ReplayKit). -->
    <Compile Include="..\MineClaw.Bot.Tests\TestSupport.cs" Link="Linked\BotTestSupport.cs" />
    <!-- In-memory b1.8.1 server for the dimension-change audit. -->
    <Compile Include="..\MineClaw.Client.Tests\FakeServer.cs" Link="Linked\FakeServer.cs" />
    <!-- b1.8.1 portal timer/cooldown + 0x09 dimension switch on that server (portal round trips). -->
    <Compile Include="..\MineClaw.Client.Tests\PortalSim.cs" Link="Linked\PortalSim.cs" />
  </ItemGroup>

</Project>
