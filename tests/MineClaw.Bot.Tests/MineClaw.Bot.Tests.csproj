<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../../docs/offline-brain.json" Link="offline-brain.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The client tests' in-process fake server: protection tests drive a real MinecraftClient through a real BotHost. -->
    <Compile Include="..\MineClaw.Client.Tests\FakeServer.cs" Link="Shared\FakeServer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
    <ProjectReference Include="..\..\tools\ReplayKit\ReplayKit.csproj" />
    <ProjectReference Include="..\..\tools\MineClaw.Sim\MineClaw.Sim.csproj" />
  </ItemGroup>

</Project>
