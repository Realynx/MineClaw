<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test-only fake clone process for MineClaw.Hive.Tests (not in the solution). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MineClaw.Hive\MineClaw.Hive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The "dupkick" mode logs a real MinecraftClient into the in-memory fake server, which then kicks it. -->
    <Compile Include="..\..\MineClaw.Client.Tests\FakeServer.cs" Link="FakeServer.cs" />
    <Compile Include="..\..\MineClaw.Client.Tests\FakeServer.Mobs.cs" Link="FakeServer.Mobs.cs" />
  </ItemGroup>

</Project>
