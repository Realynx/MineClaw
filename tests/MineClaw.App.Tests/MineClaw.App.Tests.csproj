<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not in MineClaw.sln on purpose: run with `dotnet test tests/MineClaw.App.Tests`. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="../../docs/offline-config.json" Link="offline-config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/offline-brain.json" Link="offline-brain.json" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="MineClaw.Render" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.App\MineClaw.App.csproj" />
    <ProjectReference Include="..\..\tools\MineClaw.Sim\MineClaw.Sim.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FakeGameClient / TestBot: the supervisor's live data is tested against a real VisionHub. -->
    <Compile Include="..\MineClaw.Bot.Tests\TestSupport.cs" Link="Linked\BotTestSupport.cs" />
    <!-- The fake (1.12.2) server for the P6 end-to-end scenario. -->
    <Compile Include="..\MineClaw.Client.Tests\FakeServer.cs" Link="Linked\FakeServer.cs" />
  </ItemGroup>

</Project>
