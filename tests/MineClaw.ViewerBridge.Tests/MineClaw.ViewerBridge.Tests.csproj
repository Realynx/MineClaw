<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run with `dotnet test tests/MineClaw.ViewerBridge.Tests` (signing vectors, security middleware, pass-through, db paging on a
       real fixture db, live stream framing, memory heat; no network beyond loopback, no LLM or embedding calls). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\ViewerBridge\MineClaw.ViewerBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="contract-check.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
