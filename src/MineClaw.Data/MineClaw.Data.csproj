<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 1.12.2 block/item names, ids, hardness and harvest tools (PrismarineJS minecraft-data, vendored with its LICENSE). -->
    <EmbeddedResource Include="..\..\third_party\minecraft-data\pc\1.12.2\blocks.json" LogicalName="mcdata.1.12.2.blocks.json" />
    <EmbeddedResource Include="..\..\third_party\minecraft-data\pc\1.12.2\items.json" LogicalName="mcdata.1.12.2.items.json" />
    <!-- P5: the 432 crafting recipes (= the client jar's assets/minecraft/recipes) and the FurnaceRecipes table the 1.12.2
         knowledge pack also reads (written from the decompiled source), so the bot's tables and its knowledge agree. -->
    <EmbeddedResource Include="..\..\third_party\minecraft-data\pc\1.12.2\recipes.json" LogicalName="mcdata.1.12.2.recipes.json" />
    <EmbeddedResource Include="..\..\shards\sources\1.12.2\smelting.json" LogicalName="facts.1.12.2.smelting.json" />
    <!-- The enchantments (ids, max levels, weights = rarity, categories, exclusions): the enchanting table and anvil rules. -->
    <EmbeddedResource Include="..\..\third_party\minecraft-data\pc\1.12.2\enchantments.json" LogicalName="mcdata.1.12.2.enchantments.json" />
  </ItemGroup>

</Project>
