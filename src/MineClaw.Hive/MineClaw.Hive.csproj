<Project Sdk="Microsoft.NET.Sdk">

  <!-- The hive: supervisor + IPC (main process) and the clone host (child processes). Sits between App and Bot. -->
  <ItemGroup>
    <ProjectReference Include="..\MineClaw.Bot\MineClaw.Bot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MineClaw.Hive.Tests" />
    <InternalsVisibleTo Include="MineClaw.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story Mode: the shipped pawn script, installed into the script library by default (docs/web/story-mode.md). -->
    <EmbeddedResource Include="Story\story_pawn.js" LogicalName="MineClaw.Hive.Story.story_pawn.js" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
