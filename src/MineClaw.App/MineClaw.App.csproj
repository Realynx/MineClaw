<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MineClaw.Hive\MineClaw.Hive.csproj" />
    <ProjectReference Include="..\MineClaw.Render\MineClaw.Render.csproj" />
  </ItemGroup>

  <!-- One brain, many bodies (docs/design/one-brain-many-bodies.md section 7): every body's tick shares one heap. Workstation
       concurrent GC keeps gen2 pauses short (background GC); the hard limit makes the GC work harder before the kernel's OOM
       killer takes every body at once. Was ~2.5 GB of CT 114's old 4 GB; with in-process hives (Hive:Isolation=inproc) every
       hive's brain and bodies live in this one heap too, so it is 10 GiB of the CT's 16 GB now (Hive:Resources:LimitMb 14336
       leaves the rest for native memory: SQLite, thread stacks, sockets). The resource ceiling refuses a spawn that wouldn't fit
       this heap (ResourceCeiling.Heap). Lands in MineClaw.App.runtimeconfig.json; DOTNET_GCHeapHardLimit (hex bytes) overrides
       it, e.g. 0xA0000000 (2.5 GiB) on a 4 GB host. -->
  <!-- A release stamps -p:InformationalVersion=1.2.3+<sha> itself: keep it exactly (the SDK would append the commit again),
       so the version flag and the Administration page's node info report what the release named. -->
  <PropertyGroup Condition="'$(InformationalVersion)' != ''">
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="10737418240" />
  </ItemGroup>

  <ItemGroup>
    <!-- The viewport core lives in MineClaw.Render (shared with the bot's `see` tool). -->
    <Using Include="MineClaw.Render" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageReference Include="Spectre.Console" Version="0.51.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real config (gitignored, holds API keys) and the committed template are copied next to the exe. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.json')" />
    <None Update="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MineClaw.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The read-only hive supervisor's single-file web UI (served by Supervisor/SupervisorServer). -->
    <EmbeddedResource Include="Supervisor\supervisor.html" LogicalName="MineClaw.App.Supervisor.supervisor.html" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Linux publish (deploy/publish-linux.*): self-contained single file. Native libs (SQLite's libe_sqlite3.so) stay next to
         the binary instead of being extracted to a temp dir at startup, which keeps systemd hardening (no writable $HOME/tmp) happy. -->
  </PropertyGroup>

  <!-- 1.12.2 chat translations: en_us.lang from the installed 1.12.2 client jar (PrismLauncher), shipped next to the binary as
       assets/1.12.2/assets/minecraft/lang/en_us.lang so a server without the jar (alice) renders translate components
       (LangTable.CandidateFiles). Skipped silently when the jar isn't installed (the built-in keys + a cleaned fallback remain). -->
  <PropertyGroup>
    <Lang1122Jar>$(APPDATA)\PrismLauncher\libraries\com\mojang\minecraft\1.12.2\minecraft-1.12.2-client.jar</Lang1122Jar>
  </PropertyGroup>
  <Target Name="CopyLang1122" AfterTargets="Build" Condition="Exists('$(Lang1122Jar)')">
    <Unzip SourceFiles="$(Lang1122Jar)" DestinationFolder="$(OutDir)assets\1.12.2" Include="assets/minecraft/lang/en_us.lang" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishLang1122" AfterTargets="Publish" Condition="Exists('$(Lang1122Jar)')">
    <Unzip SourceFiles="$(Lang1122Jar)" DestinationFolder="$(PublishDir)assets\1.12.2" Include="assets/minecraft/lang/en_us.lang" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
