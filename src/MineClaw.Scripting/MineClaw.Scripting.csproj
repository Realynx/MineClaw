<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MineClaw.Skills\MineClaw.Skills.csproj" />
    <ProjectReference Include="..\MineClaw.Client\MineClaw.Client.csproj" />
    <ProjectReference Include="..\MineClaw.World\MineClaw.World.csproj" />
    <ProjectReference Include="..\MineClaw.Data\MineClaw.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JavaScript engine for every script (pure managed; Acornima parser comes with it). Pinned: the current stable release. -->
    <PackageReference Include="Jint" Version="4.17.0" />
    <!-- LEGACY: pure-managed Lua 5.2 VM, only for saved Lua versions not migrated yet (removal plan: ARCHITECTURE.md). Pinned. -->
    <PackageReference Include="LuaCSharp" Version="0.5.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The JS SDK modules: evaluated before every script; their doc comments generate the author's SDK reference. -->
    <EmbeddedResource Include="Sdk\js\*.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MineClaw.Scripting.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
