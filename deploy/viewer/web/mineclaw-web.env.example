# /etc/mineclaw-web/mineclaw-web.env (optional, 0640 root:mineclaw-web): overrides for /etc/mineclaw-web/config.json.
# Any key as MINECLAW_WEB_<Section>__<Key>[__<Sub>]=value; arrays are comma-separated. Never put the bridge key here:
# the unit hands /etc/mineclaw-web/bridge.key to the service as a systemd credential.

# Later, behind cloudflared on this CT (see README.md › Cloudflare):
# MINECLAW_WEB_Web__TrustProxy=true
# MINECLAW_WEB_Web__TrustedProxies=127.0.0.1,::1
# MINECLAW_WEB_Web__AllowedOrigins=https://mineclaw.example.com,http://10.1.2.73:8080
# MINECLAW_WEB_Web__CloudflareAccess__TeamDomain=your-team
# MINECLAW_WEB_Web__CloudflareAccess__Aud=<application audience tag>

# MINECLAW_WEB_Web__LogLevel=debug
