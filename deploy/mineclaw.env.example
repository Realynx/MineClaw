# /etc/mineclaw/mineclaw.env — secrets for the systemd unit (EnvironmentFile=). chmod 600, owned by root:
# systemd reads it before dropping to User=mineclaw, so the bot user never needs read access to this file.
#
# Any config key can be set as MINECLAW_<Section>__<Key> (double underscore = nesting); these override
# /etc/mineclaw/appsettings.json and the appsettings.json shipped next to the binary.

MINECLAW_Agent__Llm__ApiKey=sk-ant-api03-REPLACE_ME
# Optional embeddings (Azure OpenAI) for vector recall; leave unset for FTS-only retrieval.
#MINECLAW_Agent__Embeddings__ApiKey=
#MINECLAW_Agent__Embeddings__Endpoint=https://YOUR-RESOURCE.openai.azure.com/

# Handy overrides without touching the JSON:
#MINECLAW_Minecraft__Host=10.1.2.69
#MINECLAW_Minecraft__DuplicateLoginBackoffSeconds=600   # wait after "You logged in from another location"
#MINECLAW_Host__ShutdownTimeoutSeconds=30
#MINECLAW_Host__LogFormat=systemd        # auto | simple | systemd | json
#MINECLAW_Telemetry__KeepDays=30
