{{/* Chart name. */}}
{{- define "mineclaw.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
{{- end }}

{{/* Full name: <release> when it already contains the chart name, else <release>-<chart>. */}}
{{- define "mineclaw.fullname" -}}
{{- if .Values.fullnameOverride }}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- $name := default .Chart.Name .Values.nameOverride }}
{{- if contains $name .Release.Name }}
{{- .Release.Name | trunc 63 | trimSuffix "-" }}
{{- else }}
{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
{{- end }}
{{- end }}
{{- end }}

{{- define "mineclaw.chart" -}}
{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
{{- end }}

{{- define "mineclaw.selectorLabels" -}}
app.kubernetes.io/name: {{ include "mineclaw.name" . }}
app.kubernetes.io/instance: {{ .Release.Name }}
{{- end }}

{{- define "mineclaw.labels" -}}
helm.sh/chart: {{ include "mineclaw.chart" . }}
{{ include "mineclaw.selectorLabels" . }}
app.kubernetes.io/version: {{ .Chart.AppVersion | quote }}
app.kubernetes.io/managed-by: {{ .Release.Service }}
app.kubernetes.io/part-of: mineclaw
{{- end }}

{{- define "mineclaw.serverImage" -}}
{{- printf "%s:%s" .Values.image.server.repository (default .Chart.AppVersion .Values.image.server.tag) }}
{{- end }}

{{- define "mineclaw.webImage" -}}
{{- printf "%s:%s" .Values.image.web.repository (default .Chart.AppVersion .Values.image.web.tag) }}
{{- end }}

{{/* The Secret with bridge-key + supervisor-token (generated by the chart unless secrets.existingSecret is set). */}}
{{- define "mineclaw.secretName" -}}
{{- default (printf "%s-secrets" (include "mineclaw.fullname" .)) .Values.secrets.existingSecret }}
{{- end }}

{{- define "mineclaw.configName" -}}
{{- printf "%s-config" (include "mineclaw.fullname" .) }}
{{- end }}

{{- define "mineclaw.dataClaim" -}}
{{- default (printf "%s-data" (include "mineclaw.fullname" .)) .Values.persistence.data.existingClaim }}
{{- end }}

{{- define "mineclaw.webClaim" -}}
{{- default (printf "%s-web-data" (include "mineclaw.fullname" .)) .Values.persistence.web.existingClaim }}
{{- end }}

{{/* Web:AllowedOrigins, comma-separated: web.allowedOrigins, else localhost (port-forward) + every ingress host. */}}
{{- define "mineclaw.allowedOrigins" -}}
{{- if .Values.web.allowedOrigins }}
{{- join "," .Values.web.allowedOrigins }}
{{- else }}
{{- $origins := list "http://localhost:8080" "http://127.0.0.1:8080" }}
{{- if .Values.ingress.enabled }}
{{- $tlsHosts := list }}
{{- range .Values.ingress.tls }}
{{- $tlsHosts = concat $tlsHosts (.hosts | default list) }}
{{- end }}
{{- range .Values.ingress.hosts }}
{{- if has .host $tlsHosts }}
{{- $origins = append $origins (printf "https://%s" .host) }}
{{- else }}
{{- $origins = append $origins (printf "http://%s" .host) }}
{{- end }}
{{- end }}
{{- end }}
{{- join "," $origins }}
{{- end }}
{{- end }}

{{/* Env every container gets: how the web's update notice describes this install. */}}
{{- define "mineclaw.installEnv" -}}
- name: MINECLAW_INSTALL_KIND
  value: helm
- name: MINECLAW_HELM_RELEASE
  value: {{ .Release.Name | quote }}
- name: MINECLAW_HELM_NAMESPACE
  value: {{ .Release.Namespace | quote }}
- name: MINECLAW_HELM_CHART
  value: {{ .Values.chartRef | quote }}
{{- end }}
