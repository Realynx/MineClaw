# /etc/systemd/system/mineclaw.service: MineClaw headless bot (see deploy/README.md).
# deploy/deploy-alice.ps1 installs and refreshes this file. By hand:
#   systemctl daemon-reload && systemctl enable --now mineclaw
#   journalctl -u mineclaw -f            # one line per event, levels as journald priorities
[Unit]
Description=MineClaw Minecraft b1.8.1 Skyblock bot (Claude agent)
Wants=network-online.target
After=network-online.target
# 24/7: never stop retrying. Restart= below spaces the attempts out (10 s growing to 5 min).
StartLimitIntervalSec=0

[Service]
Type=exec
User=mineclaw
Group=mineclaw
WorkingDirectory=/var/lib/mineclaw
# Keeps /var/lib/mineclaw and /var/log/mineclaw owned by User= and writable under ProtectSystem=strict.
StateDirectory=mineclaw
LogsDirectory=mineclaw
StateDirectoryMode=0750
LogsDirectoryMode=0750

# /etc/mineclaw/appsettings.json (0640 root:mineclaw) holds the config including the API keys. The optional env file
# can override any key as MINECLAW_Section__Key=value (see mineclaw.env.example).
EnvironmentFile=-/etc/mineclaw/mineclaw.env
Environment=MINECLAW_Agent__KnowledgeDirectory=/opt/mineclaw/current/docs/knowledge
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# /opt/mineclaw/current is a symlink to releases/<id>; deploy-alice.ps1 swaps it atomically (and -Rollback).
ExecStart=/opt/mineclaw/current/MineClaw.App --no-tui --config /etc/mineclaw/appsettings.json \
          --data-dir /var/lib/mineclaw --log-dir /var/log/mineclaw
SyslogIdentifier=mineclaw
StandardOutput=journal
StandardError=journal

# Graceful stop: SIGTERM, then stop actions, (hive: deposit items), disconnect, flush db/logs. The app's own budget is
# Host:ShutdownTimeoutSeconds (default 30); keep this well above it (and above future clone deposits).
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=120

# Exit codes: 0 clean, 1 crash, 2 config, 3 auth (bad key/model), 64 usage, 75 transient (API unreachable at start).
# Restart on everything (including exit 0 and auth errors), except a broken config or command line: those need a human
# and a redeploy restarts the service anyway. Server drops/kicks never exit; the client reconnects by itself.
Restart=always
RestartSec=10
RestartSteps=10
RestartMaxDelaySec=300
RestartPreventExitStatus=2 64

# ---- hardening (network + the state/log dirs stay available) ----
NoNewPrivileges=yes
UMask=0027
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# IPv4/IPv6 for the Minecraft server + Anthropic/Azure APIs; AF_UNIX for journald and the upcoming hive IPC.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Not set on purpose: MemoryDenyWriteExecute=yes (breaks the .NET JIT).
ReadOnlyPaths=/opt/mineclaw /etc/mineclaw

[Install]
WantedBy=multi-user.target
