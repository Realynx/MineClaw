<Project Sdk="Microsoft.NET.Sdk">

  <!-- A/B harness for the brain's spatial perception (text look vs ASCII map vs see image vs textured eye view) over the
       remembered island in a db snapshot. Not in the .sln: run it explicitly, it calls the real API (hard $ cap). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Render\MineClaw.Render.csproj" />
    <!-- Vision v2 eval (cases, perception arms, verifier) lives in the bot so the tests run it offline. -->
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

</Project>
