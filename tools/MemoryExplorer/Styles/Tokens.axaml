<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Design tokens. One accent colour, calm neutrals, subtle separators. Always reference them with DynamicResource so the
       light/dark switch (system-following, with a manual toggle) restyles everything live. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="AccentColor">#4F5BD5</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#4F5BD5" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A4F5BD5" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="WindowBrush" Color="#F4F5F8" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FAFBFC" />
      <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#F6F7FB" />
      <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E3E5EB" />
      <SolidColorBrush x:Key="TextBrush" Color="#1D2130" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6A7083" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#9AA0B1" />
      <SolidColorBrush x:Key="ChipBrush" Color="#EEF0F5" />
      <SolidColorBrush x:Key="GoodBrush" Color="#2E8B57" />
      <SolidColorBrush x:Key="WarnBrush" Color="#B7791F" />
      <SolidColorBrush x:Key="BadBrush" Color="#C24141" />
      <SolidColorBrush x:Key="GraphEdgeBrush" Color="#334F5BD5" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="AccentColor">#8A94FF</Color>
      <SolidColorBrush x:Key="AccentBrush" Color="#8A94FF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#268A94FF" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#0E1020" />
      <SolidColorBrush x:Key="WindowBrush" Color="#121419" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#171A20" />
      <SolidColorBrush x:Key="CardBrush" Color="#1C1F27" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#232733" />
      <SolidColorBrush x:Key="BorderSubtleBrush" Color="#2A2E39" />
      <SolidColorBrush x:Key="TextBrush" Color="#E7E9F0" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA1B4" />
      <SolidColorBrush x:Key="TextFaintBrush" Color="#6B7286" />
      <SolidColorBrush x:Key="ChipBrush" Color="#262A35" />
      <SolidColorBrush x:Key="GoodBrush" Color="#5CC08A" />
      <SolidColorBrush x:Key="WarnBrush" Color="#E0A94A" />
      <SolidColorBrush x:Key="BadBrush" Color="#E86A6A" />
      <SolidColorBrush x:Key="GraphEdgeBrush" Color="#408A94FF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
  <CornerRadius x:Key="CardRadius">10</CornerRadius>
  <CornerRadius x:Key="ChipRadius">999</CornerRadius>

