<Project Sdk="Microsoft.NET.Sdk">

  <!-- MineClaw Memory Explorer: a local admin desktop tool for the bot's memory bank and its RAPTOR tree, plus the Live Hive tab.
       Browsing opens the db read-only (AgentDb.OpenReadOnly); edits are explicit (edit mode) and go through the bot's own stores. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MineClaw.MemoryExplorer</RootNamespace>
    <AssemblyName>MineClaw.MemoryExplorer</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Agent\MineClaw.Agent.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.Raptor\MineClaw.Raptor.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.World\MineClaw.World.csproj" />
    <ProjectReference Include="..\..\src\MineClaw.Render\MineClaw.Render.csproj" />
    <!-- Scripts page + live script debugger: the debugger snapshot types and the offline lint of saved scripts. -->
    <ProjectReference Include="..\..\src\MineClaw.Scripting\MineClaw.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MineClaw.MemoryExplorer.Tests" />
  </ItemGroup>

</Project>
