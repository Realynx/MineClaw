<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lh="using:MineClaw.MemoryExplorer.LiveHive"
             xmlns:gpu="using:MineClaw.MemoryExplorer.LiveHive.Gpu"
             x:Class="MineClaw.MemoryExplorer.LiveHive.LiveHiveView"
             x:DataType="lh:LiveHiveViewModel">

  <UserControl.Styles>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
      <Setter Property="Fill" Value="{DynamicResource TextFaintBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.dot.good">
      <Setter Property="Fill" Value="{DynamicResource GoodBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.warn">
      <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
    </Style>
    <Style Selector="Ellipse.dot.bad">
      <Setter Property="Fill" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="ListBox.segmented">
      <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tile.focused">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.hudchip">
      <Setter Property="Background" Value="#A80E1016" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="8" />
    </Style>
    <Style Selector="Border.hudchip > TextBlock">
      <Setter Property="Foreground" Value="#F0F2F8" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.vitals">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.vitals.bad">
      <Setter Property="Foreground" Value="{DynamicResource BadBrush}" />
    </Style>
    <Style Selector="Border.legend">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- One feed tile: header (who + view picker), the picture, footer (job, vitals, held, claims). -->
    <DataTemplate x:Key="TileTemplate" x:DataType="lh:BotTileViewModel">
      <Border Classes="card tile" Classes.focused="{Binding IsFocused}" DoubleTapped="OnTileDoubleTapped">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="12,8,8,8">
            <StackPanel VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="h3" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="faint" FontSize="11" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
              <Button Classes="ghost" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Left" Click="OnScriptBadge" IsVisible="{Binding HasScript}"
                      ToolTip.Tip="This body runs a script: open the live script debugger (current line, stack, state, params, locals)">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Data="{StaticResource IconCode}" Width="11" Height="11" Foreground="{DynamicResource AccentBrush}" />
                  <TextBlock Classes="mono" FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding ScriptBadge}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" Margin="6,0,0,0" Padding="8,4" Content="Controller" Click="OnControllerButton"
                    ToolTip.Tip="What drives this body: its brain's live context, thinking and tool calls (a subhive: its owner's brain, filtered), or its script" />
            <Button Grid.Column="2" Classes="ghost" Margin="6,0,0,0" Padding="8,4" Content="AI vision" Click="OnVisionButton"
                    ToolTip.Tip="What the AI saw: the exact sheets its models got (history, zoom, save), and compose your own angles" />
            <Button Grid.Column="3" Classes="ghost" Margin="6,0,6,0" Padding="8,4" Content="Fly" Click="OnFlyHere"
                    ToolTip.Tip="Open the free camera at this bot's eyes" />
            <ComboBox Grid.Column="4" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" MinWidth="104"
                      ToolTip.Tip="Eye: live first-person view rendered here with textures. Iso, Top + roles, Side: the server's pictures. AI's last sheet: the picture the AI last got." />
          </Grid>
          <Panel Grid.Row="1" Background="#0B0D12" MinHeight="90">
            <TextBlock Classes="faint" Text="waiting for the server's picture…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsMap}" />
            <lh:FrameView Source="{Binding Eye.Frames}" IsVisible="{Binding IsEye}" />
            <Image Source="{Binding MapImage}" IsVisible="{Binding IsMap}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            <TextBlock Classes="faint" Text="no sheet yet: the AI hasn't looked since this bot started" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="12" IsVisible="{Binding IsVision}" />
            <Image Source="{Binding VisionImage}" IsVisible="{Binding IsVision}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            <Border Classes="hudchip" VerticalAlignment="Bottom" HorizontalAlignment="Left" IsVisible="{Binding IsVision}">
              <TextBlock Classes="mono" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding VisionAge}" /><Run Text=" · " /><Run Text="{Binding VisionCaption}" />
              </TextBlock>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left">
              <Border Classes="hudchip"><TextBlock Classes="mono" Text="{Binding Where}" /></Border>
              <Border Classes="hudchip" Margin="0,8" IsVisible="{Binding PoseNote, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding PoseNote}" />
              </Border>
            </StackPanel>
            <Border Classes="hudchip" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#C8B0302A" IsVisible="{Binding IsStale}"
                    ToolTip.Tip="The picture hasn't changed for a while: the link is down or the server is slow. It keeps retrying.">
              <TextBlock Classes="mono" Foreground="White" Text="{Binding StaleText}" />
            </Border>
          </Panel>
          <StackPanel Grid.Row="2" Margin="12,8,12,10" Spacing="3">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Job}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Job}" />
              <TextBlock Grid.Column="1" Classes="mono vitals" Classes.bad="{Binding LowHp}" Margin="12,0,0,0" Text="{Binding Vitals}" />
            </Grid>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Held}" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Held, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock Classes="muted" FontSize="12" Text="{Binding Claims}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasClaims}"
                       ToolTip.Tip="{Binding Claims}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*" Margin="20,16,20,16">

    <!-- Connection bar: state, latency, URL, connect, tunnel. The token is never shown. -->
    <Border Classes="card" Padding="16,12">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Ellipse Classes="dot" Classes.good="{Binding IsConnected}" Classes.warn="{Binding IsConnecting}" Classes.bad="{Binding HasProblem}" />
          <TextBlock Classes="h2" Text="Live Hive" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding StateText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
          <Border Classes="chip" IsVisible="{Binding IsConnected}" VerticalAlignment="Center">
            <TextBlock Classes="mono" Text="{Binding LatencyText}" />
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBox Classes="mono" Width="230" Text="{Binding BaseUrl}" Watermark="http://10.1.2.73:8765" VerticalAlignment="Center" />
          <Button Classes="accent" Content="{Binding ConnectLabel}" Command="{Binding ToggleConnectCommand}" />
          <Button Content="Tunnel" Command="{Binding StartTunnelCommand}"
                  ToolTip.Tip="Start/stop: ssh -N -L 8765:10.1.2.73:8765 alice (then connects to http://localhost:8765)" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="19,6,0,0" Orientation="Horizontal">
          <TextBlock Classes="faint" FontSize="12" Text="{Binding TokenStatus}" Margin="0,0,16,0" />
          <TextBlock Classes="faint" FontSize="12" Text="{Binding TextureStatus}" Margin="0,0,16,0" />
          <TextBlock Classes="faint" FontSize="12" Text="{Binding SyncText}" Margin="0,0,16,0" />
          <TextBlock Classes="faint" FontSize="12" Text="{Binding TunnelStatus}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="1" Margin="0,12,0,0">
      <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">

        <!-- ============================================================ bot feeds -->
        <TabItem Header="Bot feeds">
          <Grid RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="6,0,6,6">
              <TextBlock Classes="muted" Text="Layout" VerticalAlignment="Center" Margin="0,0,10,0" />
              <ListBox Grid.Column="1" Classes="segmented" ItemsSource="{Binding LayoutOptions}" SelectedItem="{Binding SelectedLayout}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="lh:LayoutOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Column="2" Classes="faint" FontSize="12" Margin="16,0" VerticalAlignment="Center" Text="{Binding HiddenTiles}" />
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="All tiles" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding DefaultMode}" MinWidth="130" />
              </StackPanel>
            </Grid>

            <Panel Grid.Row="1">
              <ItemsControl ItemsSource="{Binding GridTiles}" ItemTemplate="{StaticResource TileTemplate}" IsVisible="{Binding IsGridLayout}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid x:DataType="lh:LiveHiveViewModel" Columns="{Binding GridColumns}" Rows="{Binding GridRows}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <Grid RowDefinitions="*,210" IsVisible="{Binding IsFocusLayout}">
                <ContentControl Content="{Binding FocusedTile}" ContentTemplate="{StaticResource TileTemplate}" />
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding StripTiles}" ItemTemplate="{StaticResource TileTemplate}">
                    <ItemsControl.Styles>
                      <Style Selector="ItemsControl > ContentPresenter">
                        <Setter Property="Width" Value="300" />
                      </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" IsVisible="{Binding ShowNoBots}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Classes="h2" Text="No bodies online" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" Text="The hive is reachable, but no bot is logged in right now." HorizontalAlignment="Center" />
                </StackPanel>
              </Border>

              <!-- The vision panel (a tile's "AI vision" button): what the AI saw + compose. Read-only. -->
              <Border Classes="card" MaxWidth="1180" HorizontalAlignment="Stretch" Margin="6" Padding="14,12" IsVisible="{Binding HasVision}"
                      BoxShadow="0 6 28 0 #50000000">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <Run Text="AI vision · " /><Run Text="{Binding Vision.Title, FallbackValue=''}" />
                    </TextBlock>
                    <Button Grid.Column="1" Classes="ghost" Padding="8,3" Content="Close" Command="{Binding CloseVisionCommand}" />
                  </Grid>
                  <lh:VisionPanelView Grid.Row="1" Margin="0,8,0,0" DataContext="{Binding Vision}" />
                </Grid>
              </Border>

              <!-- The Controller panel (a tile's "Controller" button): the brain's context / the owner's brain / the script. Read-only. -->
              <Border Classes="card" Width="780" HorizontalAlignment="Right" Margin="6" Padding="14,12" IsVisible="{Binding HasController}"
                      BoxShadow="0 6 28 0 #50000000">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="Controller" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Padding="8,3" Content="Close" Command="{Binding CloseControllerCommand}" />
                  </Grid>
                  <lh:ControllerPanelView Grid.Row="1" Margin="0,8,0,0" DataContext="{Binding Controller}" />
                </Grid>
              </Border>

              <!-- The live script debugger (a tile's "script" badge opens it; read-only, polls while open). -->
              <Border Classes="card" Width="620" HorizontalAlignment="Right" Margin="6" Padding="14,12" IsVisible="{Binding HasScriptDebug}"
                      BoxShadow="0 6 28 0 #50000000">
                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="h2" Text="Script debugger" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost" Padding="8,3" Content="Close" Command="{Binding CloseScriptCommand}" />
                  </Grid>
                  <lh:ScriptDebugView Grid.Row="1" Margin="0,8,0,0" DataContext="{Binding ScriptDebug}" />
                </Grid>
              </Border>
            </Panel>
          </Grid>
        </TabItem>

        <!-- ============================================================ free camera -->
        <TabItem Header="Free camera">
          <Grid ColumnDefinitions="*,310">
            <Border Classes="card" Padding="0" ClipToBounds="True">
              <Panel>
                <lh:FreecamView x:Name="Cam" Source="{Binding Freecam}" IsVisible="{Binding UseCpuFreecam}" />
                <gpu:GlFreecamView x:Name="GlCam" Model="{Binding Gpu}" IsVisible="{Binding UseGpuFreecam}" />
                <gpu:FreecamOverlay x:Name="GlOverlay" Model="{Binding Gpu}" IsVisible="{Binding UseGpuFreecam}" />
              </Panel>
            </Border>
            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h3" Text="Go to" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox x:Name="JumpBox" Text="{Binding JumpText}" Watermark="x,y,z · a place · a bot" KeyDown="OnJumpKey" />
                      <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Content="Go" Command="{Binding JumpCommand}" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding JumpStatus}" TextWrapping="Wrap" />
                    <TextBlock Classes="faint" FontSize="12" Text="Snap to a bot" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding AllTiles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lh:BotTileViewModel">
                          <Button Classes="ghost" Margin="0,0,6,6" Padding="10,4" Content="{Binding Key}" Click="OnFlyHere" ToolTip.Tip="{Binding Job}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="h3" Text="Camera" />
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock Classes="muted" Text="Dimension" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding DimOptions}" SelectedItem="{Binding SelectedDim}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="lh:DimOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <TextBlock Classes="muted" Text="Speed" VerticalAlignment="Center" Margin="0,0,10,0" />
                      <Slider Grid.Column="1" Minimum="1" Maximum="100" Value="{Binding Speed}" />
                      <TextBlock Grid.Column="2" Classes="mono" Margin="8,0,0,0" VerticalAlignment="Center"
                                 Text="{Binding Speed, StringFormat={}{0:0} b/s}" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="Overlays" />
                    <CheckBox IsChecked="{Binding ShowBots}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#FF9F43" /><TextBlock Text="Bots and players" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowClaims}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#FFD84A" /><TextBlock Text="Claims and gen cells" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowPlaces}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#E8ECF4" /><TextBlock Text="Structures and places" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowChests}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#FFA040" /><TextBlock Text="Chests, gens, farms, portals" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowPlans}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#5EE6E6" /><TextBlock Text="Build plans (ghost blocks)" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowDangers}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#FF5050" /><TextBlock Text="Dangers" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowDrops}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#F2E46A" /><TextBlock Text="Drops (name and count)" /></StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowStaleness}">
                      <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="legend" Background="#6B7A99" /><TextBlock Text="Tint areas not seen recently" /></StackPanel>
                    </CheckBox>
                    <TextBlock Classes="faint" FontSize="12" Text="{Binding OverlayNotes}" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>

                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="h3" Text="Drops" />
                    <TextBlock Classes="faint" FontSize="12" Text="{Binding DropsSummary}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Drops}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="lh:DropRow">
                          <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="8,4"
                                  Command="{Binding $parent[ItemsControl].((lh:LiveHiveViewModel)DataContext).FlyToDropCommand}" CommandParameter="{Binding}"
                                  ToolTip.Tip="Fly to this drop">
                            <StackPanel>
                              <TextBlock Text="{Binding Text}" />
                              <TextBlock Classes="mono faint" FontSize="11" Text="{Binding Where}" />
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h3" Text="Render" />
                    <TextBlock Classes="faint" FontSize="12" Text="{Binding RendererNote}" TextWrapping="Wrap" IsVisible="{Binding RendererNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding FreecamStats}" TextWrapping="Wrap" />
                    <TextBlock Classes="mono muted" FontSize="12" Text="{Binding CacheStats}" TextWrapping="Wrap" />
                    <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Rendered here from the hive's shared world memory: live columns and every bot's remembered chunks. Older areas are dimmer." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- ============================================================ hive tree (owner → children; no fixed roster) -->
        <TabItem Header="Hive tree">
          <Border Classes="card" Padding="16,12">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Classes="muted" Text="{Binding TreeSummary}" Margin="0,0,0,10" />
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding TreeRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="lh:HiveTreeRow">
                      <Grid ColumnDefinitions="Auto,170,90,90,*" Margin="{Binding Indent}" Height="26">
                        <TextBlock Classes="faint" Text="{Binding Branch}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Label}" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                        <TextBlock Grid.Column="2" Text="{Binding Kind}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Brain}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="faint" Text="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </TabItem>
      </TabControl>

      <!-- Not connected: what to check. -->
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MaxWidth="560" IsVisible="{Binding ShowDisconnected}">
        <StackPanel Spacing="8">
          <TextBlock Classes="h2" Text="Not connected to the hive" />
          <TextBlock Classes="muted" Text="{Binding StateText}" TextWrapping="Wrap" />
          <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap"
                     Text="The Supervisor runs inside the main bot (Supervisor:Enabled). If 10.1.2.73 isn't reachable from this PC, press Tunnel to forward it through alice. The token is read from ~/.mineclaw-supervisor-token." />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
            <Button Classes="accent" Content="{Binding ConnectLabel}" Command="{Binding ToggleConnectCommand}" />
            <Button Content="Tunnel" Command="{Binding StartTunnelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Panel>
  </Grid>
</UserControl>
