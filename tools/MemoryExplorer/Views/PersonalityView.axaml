<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MineClaw.MemoryExplorer.ViewModels"
             xmlns:v="using:MineClaw.MemoryExplorer.Views"
             xmlns:c="using:MineClaw.MemoryExplorer.Controls"
             x:Class="MineClaw.MemoryExplorer.Views.PersonalityView"
             x:DataType="vm:PersonalityViewModel">
  <Grid ColumnDefinitions="3*,2*">
    <ScrollViewer>
      <StackPanel Margin="28,24,16,24" Spacing="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Classes="h1" Text="Personality" />
            <TextBlock Classes="muted" Text="{Binding Summary}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="muted" Text="Scope" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" MinWidth="170" />
          </StackPanel>
        </Grid>

        <Border Classes="card" IsVisible="{Binding Mood.Count, Converter={x:Static c:ResourceConverters.Positive}}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Mood (hours-scale aggregates)" />
            <ItemsControl ItemsSource="{Binding Mood}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MoodItem">
                  <Grid ColumnDefinitions="110,*,60" Margin="0,4">
                    <TextBlock Text="{Binding Axis}" />
                    <ProgressBar Grid.Column="1" Classes="strength" Value="{Binding Bar}" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ValueText}" HorizontalAlignment="Right" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TraitGroup">
              <Border Classes="card" Margin="0,0,0,14">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="{Binding Header}" />
                  <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TraitRow">
                        <Grid ColumnDefinitions="*,140,44" Margin="0,6" ToolTip.Tip="{Binding Reason}">
                          <StackPanel Spacing="2">
                            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            <TextBlock Classes="faint">
                              <Run Text="{Binding Meta, Mode=OneWay}" />
                              <Run Text="{Binding PlayerText, Mode=OneWay}" />
                            </TextBlock>
                          </StackPanel>
                          <ProgressBar Grid.Column="1" Classes="strength" Value="{Binding Strength}" Maximum="100" VerticalAlignment="Center" Margin="12,0" />
                          <TextBlock Grid.Column="2" Classes="muted" Text="{Binding StrengthText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card" IsVisible="{Binding Abstractions.Count, Converter={x:Static c:ResourceConverters.Positive}}">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Self-tree abstractions (what reflection reads)" />
            <ItemsControl ItemsSource="{Binding Abstractions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AbstractionItem">
                  <StackPanel Margin="0,5" Spacing="2">
                    <TextBlock Classes="h3" Text="{Binding Label}" />
                    <SelectableTextBlock Classes="body" Text="{Binding Text}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Column="1" Classes="pane">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,24,22,10" Spacing="3">
          <TextBlock Classes="h2" Text="History" />
          <TextBlock Classes="muted" FontSize="12" Text="Every versioned change (add, reinforce, adjust, remove), newest first." />
        </StackPanel>
        <ListBox Classes="plain" ItemsSource="{Binding History}" Margin="12,0,12,12">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryItem">
              <Grid ColumnDefinitions="80,*">
                <StackPanel>
                  <TextBlock FontWeight="SemiBold" FontSize="12" Text="{Binding Version}" />
                  <TextBlock Classes="faint" FontSize="10.5" Text="{Binding When}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="chip" Padding="6,0"><TextBlock Text="{Binding Op}" /></Border>
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Section}" VerticalAlignment="Center" />
                    <TextBlock Classes="faint" Text="{Binding Source}" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock FontSize="12.5" Text="{Binding Text}" TextWrapping="Wrap" />
                  <TextBlock Classes="faint" Text="{Binding Reason}" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <v:EmptyState Grid.ColumnSpan="2" Text="{Binding EmptyText}" IsBusy="{Binding IsLoading}" />
  </Grid>
</UserControl>
