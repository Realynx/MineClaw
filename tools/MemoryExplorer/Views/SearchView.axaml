<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MineClaw.MemoryExplorer.ViewModels"
             xmlns:c="using:MineClaw.MemoryExplorer.Controls"
             xmlns:v="using:MineClaw.MemoryExplorer.Views"
             x:Class="MineClaw.MemoryExplorer.Views.SearchView"
             x:DataType="vm:SearchViewModel">
  <Grid ColumnDefinitions="5*,Auto,4*">
    <DockPanel Margin="24,20,12,16">
      <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,12">
        <TextBlock Classes="h1" Text="Search" />
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="QueryBox" Classes="search" Text="{Binding Query}" Watermark="Ask what the bot remembers… (Enter)" FontSize="14">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,0,0" Foreground="{DynamicResource TextMutedBrush}" />
            </TextBox.InnerLeftContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding RunSearchCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <ComboBox Grid.Column="1" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}" MinWidth="130" VerticalAlignment="Stretch" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding DimensionOptions}" SelectedItem="{Binding Dimension}" MinWidth="140" VerticalAlignment="Stretch" />
          <Button Grid.Column="3" Classes="accent" Command="{Binding RunSearchCommand}">Search</Button>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Classes="badge" Classes.warn="{Binding IsLexical}">
            <TextBlock Text="{Binding IsLexical, Converter={x:Static c:SearchConverters.ModeLabel}}" />
          </Border>
          <TextBlock Classes="muted" FontSize="12" Text="{Binding ModeNote}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Classes="faint" Text="{Binding ResultInfo}" />
      </StackPanel>

      <Border Classes="card" Padding="4">
        <ListBox Classes="plain" ItemsSource="{Binding Hits}" SelectedItem="{Binding SelectedHit}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:HitRow">
              <Grid ColumnDefinitions="34,*,Auto" Margin="0,4">
                <TextBlock Classes="faint" FontSize="13" Text="{Binding Rank}" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="chip" Padding="7,1"><TextBlock Text="{Binding Kind}" /></Border>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="520" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="12.5" Text="{Binding Snippet}" TextWrapping="Wrap" MaxLines="3" />
                  <ItemsControl ItemsSource="{Binding Path}" IsVisible="{Binding HasPath}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:Crumb">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Classes="faint" FontSize="11" Text="{Binding Label}" />
                          <TextBlock Classes="faint" FontSize="11" Text="  ›  " />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,4,0" HorizontalAlignment="Right">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Score}" HorizontalAlignment="Right" />
                  <TextBlock Classes="faint" FontSize="11" Text="{Binding Signals}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource BorderSubtleBrush}" ResizeDirection="Columns" />

    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
      <ScrollViewer>
        <StackPanel Margin="22,20" Spacing="16">
          <StackPanel Spacing="10" IsVisible="{Binding SelectedHit, Converter={x:Static ObjectConverters.IsNotNull}}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <SelectableTextBlock Classes="h2" FontSize="16" Text="{Binding SelectedHit.Title, FallbackValue=''}" TextWrapping="Wrap" />
                <SelectableTextBlock Classes="mono muted" FontSize="11.5" Text="{Binding SelectedHit.Ref, FallbackValue=''}" />
                <TextBlock Classes="faint">
                  <Run Text="score " /><Run Text="{Binding SelectedHit.Score, FallbackValue='', Mode=OneWay}" />
                  <Run Text=" · " /><Run Text="{Binding SelectedHit.Signals, FallbackValue='', Mode=OneWay}" />
                  <Run Text=" · updated " /><Run Text="{Binding SelectedHit.Updated, FallbackValue='', Mode=OneWay}" />
                  <Run Text=" " /><Run Text="{Binding SelectedHit.Where, FallbackValue='', Mode=OneWay}" />
                </TextBlock>
              </StackPanel>
              <Button Grid.Column="1" Classes="icon" VerticalAlignment="Top" ToolTip.Tip="Copy the text"
                      Command="{Binding CopyCommand}" CommandParameter="{Binding SelectedHit.Body, FallbackValue=''}">
                <PathIcon Data="{StaticResource IconCopy}" />
              </Button>
            </Grid>
            <Border Classes="card">
              <SelectableTextBlock Classes="body" Text="{Binding SelectedHit.Body, FallbackValue=''}" />
            </Border>
            <StackPanel Spacing="6" IsVisible="{Binding SelectedHit.HasPath, FallbackValue=False}">
              <TextBlock Classes="h3" Text="PATH THROUGH THE TREE" />
              <ItemsControl ItemsSource="{Binding SelectedHit.Path, FallbackValue={x:Null}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:Crumb">
                    <StackPanel Orientation="Horizontal">
                      <Button Classes="link" FontSize="12" Content="{Binding Label}"
                              Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenInTreeCommand}" CommandParameter="{Binding Index}" />
                      <PathIcon Data="{StaticResource IconChevron}" Width="10" Height="10" Margin="2,0" Foreground="{DynamicResource TextFaintBrush}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>

          <StackPanel Spacing="8" IsVisible="{Binding TreeHits.Count, Converter={x:Static c:ResourceConverters.Positive}}">
            <Border Classes="separator" />
            <TextBlock Classes="h3" Text="WHAT THE RAPTOR TREE CONTRIBUTED (BEFORE FUSION)" />
            <ItemsControl ItemsSource="{Binding TreeHits}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TreeHitRow">
                  <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,1"
                          Command="{Binding $parent[UserControl].((vm:SearchViewModel)DataContext).OpenInTreeCommand}" CommandParameter="{Binding Index}">
                    <Grid ColumnDefinitions="84,96,*,Auto">
                      <TextBlock Classes="faint" Text="{Binding List}" />
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Label}" />
                      <TextBlock Grid.Column="2" FontSize="12" Classes="muted" Text="{Binding Preview}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="3" FontSize="12" Text="{Binding Score}" Margin="10,0,0,0" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <v:EmptyState Grid.ColumnSpan="3" Text="{Binding EmptyText}" IsBusy="{Binding IsLoading}" />
  </Grid>
</UserControl>
