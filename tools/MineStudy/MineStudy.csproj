<Project Sdk="Microsoft.NET.Sdk">

  <!-- The mine layout study: which blueprint finds the most ore per block dug on the Design Studio's terrain.
       See docs/design/mine-blueprints.md. Run it with dotnet run (see the doc); an optional argument sets the seed count. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MineStudy</AssemblyName>
    <RootNamespace>MineClaw.MineStudy</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
  </ItemGroup>

</Project>
