<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the default knowledge packs in shards/defaults from pristine sources. See shards/defaults/README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShardPacks</AssemblyName>
    <RootNamespace>MineClaw.ShardPacks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MineClaw.Agent\MineClaw.Agent.csproj" />
    <!-- sdk-js pack: the SDK modules and the game functions of an offline bot -->
    <ProjectReference Include="..\..\src\MineClaw.Bot\MineClaw.Bot.csproj" />
  </ItemGroup>

</Project>
