# The repo-root .gitignore (Visual Studio template) ignores **/packages/*; the npm workspaces live there, so re-include them.
!/packages/*

node_modules/
.next/
dist/
.turbo/
coverage/
*.tsbuildinfo
.env*.local

# The world viewer's game assets, extracted from your own client jars (npm run assets:extract / assets:pack): Mojang's
# files, never committed.
packages/world-viewer/assets/
packages/world-viewer/generated/
