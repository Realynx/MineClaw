  "noPolicies Policies": "<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto max-h-[52vh] w-[44rem] max-w-[calc(100vw-1rem)] overflow-auto p-2 text-xs" aria-label="Assign" data-testid="assign-panel"><div class="mb-2 flex gap-1" role="tablist"><button type="button" role="tab" aria-selected="false" class="rounded px-2 py-1 font-semibold text-muted hover:bg-surface-2 hover:text-fg">Pawns</button><button type="button" role="tab" aria-selected="true" class="rounded px-2 py-1 font-semibold bg-accent-soft text-fg">Policies</button><button type="button" role="tab" aria-selected="false" class="rounded px-2 py-1 font-semibold text-muted hover:bg-surface-2 hover:text-fg">Tool rules</button><button type="button" role="tab" aria-selected="false" class="rounded px-2 py-1 font-semibold text-muted hover:bg-surface-2 hover:text-fg">Spare tools</button></div><div class="flex gap-3" data-testid="policy-editor"><ul class="w-36 shrink-0 space-y-0.5"><li><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg> New policy</button></li></ul><p class="text-muted">Pick a policy, or make a new one.</p></div></section>",
