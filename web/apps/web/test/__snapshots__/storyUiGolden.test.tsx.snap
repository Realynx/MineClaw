t="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Growing zone</span></button><button type="button" aria-pressed="false" title="Trees here are cut and replanted (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Woodlot</span></button><button type="button" aria-pressed="false" title="Pawns dig everything down to bedrock (a spiral stair), or only the ores (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Quarry</span></button><button type="button" aria-pressed="false" title="Pawns fish here with rods (still water only) (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Fishing zone</span></button><button type="button" aria-pressed="false" title="Loot goes here while the colony has no storage (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Drop spot</span></button><button type="button" aria-pressed="false" title="Where pawns rest and keep things tidy (an overlay layer)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Home area</span></button><button type="button" aria-pressed="false" title="Pawns never walk here (an overlay layer)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Keep out</span></button><button type="button" aria-pressed="false" title="Drag over zones to erase those cells (empty zones go, a zone cut in two becomes two)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-4 size-5" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-center">Erase zone</span></button><div class="w-full" data-testid="grow-plant-picker"><div class="mb-1 text-[11px] font-semibold text-muted">Plant</div><div class="flex flex-wrap gap-1" role="radiogroup" aria-label="Plant"><button type="button" role="radio" aria-checked="true" title="Wheat: sows wheat_seeds on farmland. Seeds: cut tall grass (seeds drop) or harvest wheat" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-accent bg-accent-soft text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Seeds" aria-label="Seeds">Se</span>Wheat</button><button type="button" role="radio" aria-checked="false" title="Carrots: sows carrot on farmland. Seeds: the carrot itself: harvests, zombie drops, village farms and chests" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Carrot" aria-label="Carrot">Ca</span>Carrots</button><button type="button" role="radio" aria-checked="false" title="Potatoes: sows potato on farmland. Seeds: the potato itself: harvests, zombie drops, village farms and chests" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Potato" aria-label="Potato">Po</span>Potatoes</button><button type="button" role="radio" aria-checked="false" title="Beetroot: sows beetroot_seeds on farmland. Seeds: harvest beetroot; village farms and chests" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Item 435" aria-label="Item 435">It</span>Beetroot</button><button type="button" role="radio" aria-checked="false" title="Pumpkin: sows pumpkin_seeds on farmland. Seeds: craft them from a pumpkin (a bill at a crafting table)" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Item 361" aria-label="Item 361">It</span>Pumpkin</button><button type="button" role="radio" aria-checked="false" title="Melon: sows melon_seeds on farmland. Seeds: craft them from a melon slice (a bill at a crafting table)" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Item 362" aria-label="Item 362">It</span>Melon</button><button type="button" role="radio" aria-checked="false" title="Sugar cane: sows reeds on cane. Seeds: the cane itself: found by water" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Sugar cane" aria-label="Sugar cane">Su</span>Sugar cane</button><button type="button" role="radio" aria-checked="false" title="Cactus: sows cactus on sand. Seeds: the cactus itself: found in deserts" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Cactus" aria-label="Cactus">Ca</span>Cactus</button><button type="button" role="radio" aria-checked="false" title="Oak sapling: sows sapling on dirt. Seeds: leaves of chopped oaks drop them" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Sapling" aria-label="Sapling">Sa</span>Oak sapling</button><button type="button" role="radio" aria-checked="false" title="Birch sapling: sows birch_sapling on dirt. Seeds: leaves of chopped birches drop them" class="flex items-center gap-1 rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 16px; height: 16px;" title="Sapling" aria-label="Sapling">Sa</span>Birch sapling</button></div></div><p class="w-full text-[11px] leading-snug text-muted">Drag to paint. Cells touching a zone of the same type join it; work zones replace each other; Home area and Keep out are overlay layers. Shift-drag from inside a zone extends that zone.</p></div></section></div>",
  "home": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="false" title="Fell every tree in the area (whole trees)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000