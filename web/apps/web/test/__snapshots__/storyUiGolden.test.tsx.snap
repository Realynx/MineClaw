}
`;

exports[`ColonyPanel > renaming a house 1`] = `"<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto w-[26rem] space-y-3 p-3 text-xs" aria-label="Colony" data-testid="colony-panel"><div><div class="mb-1 font-semibold">Colonies</div><ul class="space-y-1"><li><button type="button" aria-pressed="true" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-accent bg-accent-soft"><span class="font-semibold">Golden</span><span class="text-muted">2 pawns</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-border hover:bg-surface-2"><span class="font-semibold">Old</span><span class="text-muted">released</span><span class="ml-auto text-warn">paused</span></button></li></ul></div><div class="flex gap-2"><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause colony</button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md">Release pawns</button></div><div class="text-muted" data-testid="colony-seats">3 of 4 pawns in game · server: 0 seats free, 1 kept for regulars</div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="colony-home"><div class="flex items-center gap-2"><span class="font-semibold">Home</span><span class="text-muted tabular-nums">0, 0</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto" title="Click the spot on the map"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-3.5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>Set home on the map</button><button type="button" disabled="" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house lucide-home size-3.5" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Move home here (migrate)</button></div><p class="text-[10.5px] text-subtle">Here is the map centre. Pawns far from the new home are brought to it.</p></div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="houses"><div class="flex items-center gap-2"><span class="font-semibold">Houses</span><span class="text-muted">home areas</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Draw a house</button></div><ul class="space-y-1"><li class="flex flex-wrap items-center gap-1.5" data-zone="z141"><form class="flex min-w-0 flex-1 gap-1"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-6 text-xs" aria-label="Name of Camp" maxlength="40" value="Camp"><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md h-6">Save</button></form></li></ul></div><form class="space-y-2 rounded-md border border-border p-2" aria-label="Found a colony"><div class="font-semibold">Found a colony</div><div class="flex items-center gap-2"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-7 text-xs" aria-label="Colony name" maxlength="40" value="Hollow"><div class="flex items-center gap-1 whitespace-nowrap" role="group" aria-label="Pawns"><span>Pawns</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="Fewer pawns">−</button><output aria-label="Number of pawns" aria-live="polite" class="min-w-[2ch] text-center text-sm font-semibold tabular-nums text-fg">4</output><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="More pawns" title="More pawns (Shift: 10 more)">+</button></div></div><p class="text-[10.5px] text-muted" data-testid="settle-at">Settles at the map centre.</p><p class="text-[10.5px] text-subtle">Pawns are script-only bodies running the colony script. Any number: as many as the server's seats and memory allow come now, the rest join as room frees up.</p><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-accent text-accent-fg hover:bg-accent-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md">Found colony</button></form></section>"`;

exports[`ControlCluster > every state 1`] = `
{
  "other": "<div class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex flex-col gap-1.5 p-2 text-xs" data-testid="story-controls"><div class="flex items-center gap-2"><span class="max-w-36 truncate text-[13px] font-semibold">Golden</span><span class="flex items-center gap-1 tabular-nums text-muted" title="Waiting for the server's time" data-testid="colony-clock"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun size-3.5 text-warn" aria-label="day"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><span data-testid="colony-time">–</span></span><button type="button" disabled="" aria-pressed="true" class="ml-auto inline-flex h-6 items-center gap-1 rounded px-1.5 font-medium bg-warn-soft text-warn" title="Pause the colony: every pawn holds (Space)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play size-3.5" aria-hidden="true"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"></path></svg>Paused</button><div role="radiogroup" aria-label="Pawn speed" class="flex items-center rounded bg-surface-2" data-testid="speed-control"><button type="button" role="radio" aria-checked="false" aria-label="Normal speed" disabled="" title="Normal speed (1): Pawns walk and sprint at normal speed — some pawns run at this speed: the server rejected faster movement" data-speed="normal" class="inline-flex h-6 min-w-6 items-center justify-center rounded px-1 text-[10px] leading-none tracking-[-0.15em] tabular-nums hover:bg-surface-3 ring-1 ring-warn ring-inset">▶</button><button type="button" role="radio" aria-checked="true" aria-label="Fast" disabled="" title="Fast (2): Pawns move about twice as fast: a movement-speed boost for the colony's pawns only (not time: the server owns the clock)" data-speed="fast" class="inline-flex h-6 min-w-6 items-center justify-center rounded px-1 text-[10px] leading-none tracking-[-0.15em] tabular-nums bg-accent-soft text-accent">▶▶</button><button type="button" role="radio" aria-checked="false" aria-label="Faster" disabled="" title="Faster (3): Pawns move about three times as fast: a movement-speed boost for the colony's pawns only; it steps down by itself if the server rejects it" data-speed="faster" class="inline-flex h-6 min-w-6 items-center justify-center rounded px-1 text-[10px] leading-none tracking-[-0.15em] tabular-nums hover:bg-surface-3">▶▶▶</button></div></div><div class="flex items-center gap-1.5"><button type="button" class="inline-flex h-6 items-center gap-1 rounded bg-surface-2 px-1.5 font-medium hover:bg-surface-3" title="Top-down ↔ angled view (V)" aria-label="Switch to the top-down view"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 size-3.5" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>Angled</button><div class="flex items-center rounded bg-surface-2" data-testid="level-widget"><button type="button" class="grid size-6 place-items-center rounded hover:bg-surface-3" aria-label="Level down (PgDn)" title="Level down (PgDn; Shift: one block)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-down size-3.5" aria-hidden="true"><path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path></svg></button><span class="px-1 tabular-nums" aria-live="polite">Storey 2 · Y 70</span><button type="button" class="grid size-6 place-items-center rounded hover:bg-surface-3" aria-label="Level up (PgUp)" title="Level up (PgUp; Shift: one block)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-up size-3.5" aria-hidden="true"><path d="m5 12 7-7 7 7"></path><path d="M12 19V5"></path></svg></button></div><button type="button" aria-pressed="true" class="grid size-6 place-items-center rounded bg-accent-soft text-accent" title="Roofs x-rayed (X)" aria-label="X-ray above the level"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-off size-3.5" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg></button><button type="button" class="grid size-6 place-items-center rounded hover:bg-surface-2" title="Controls (?)" aria-label="Controls"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-info size-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg></button><button type="button" class="grid size-6 place-items-center rounded hover:bg-surface-2" title="Viewer quality" aria-label="Viewer quality" aria-haspopup="dialog" aria-expanded="false" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-gauge size-3.5" aria-hidden="true"><path d="m12 14 4-4"></path><path d="M3.34 19a10 10 0 1 1 17.32 0"></path></svg></button></div><span>extra</span></div>",
  "plain": "<div class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex flex-col gap-1.5 p-2 text-xs" data-testid="story-controls"><div class="flex items-center gap-2"><span class="max-w-36 truncate text-[13px] font-semibold">Golden</span><span class="flex items-center gap-1 tabular-nums text-muted" title="Waiting for the server's time" data-testid="colony-clock"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun size-3.5 text-warn" aria-label="day"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg><span data-testid="colony-time">–</span></span><button type="button" aria-pressed="false" class="ml-auto inline-flex h-6 items-center gap-1 rounded px-1.5 font-medium hover:bg-surface-2" title="Pause the colony: every pawn holds (Space)"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause</button></div><div class="flex items-center gap-1.5"><button type="button" class="inline-flex h-6 items-center gap-1 rounded bg-surface-2 px-1.5 font-medium hover:bg-surface-3" title="Top-down ↔ angled view (V)" aria-label="Switch to the angled view"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide luci