  "lava Production": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Production</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"></div></section><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto max-h-[46vh] w-[22rem] overflow-auto p-2" aria-label="Placeables" data-testid="architect-palette"><div class="grid grid-cols-2 gap-1"><button type="button" data-entry="crafting_table" data-tier="hand" data-unlocked="true" title="Made: craft Crafting Table from Log" class="flex min-w-0 items-center gap-1.5 rounded-md border px-1.5 py-1 text-left text-[11px] border-border bg-surface-2 hover:border-border-strong"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 20px; height: 20px;" title="Crafting table" aria-label="Crafting table">Cr</span><span class="min-w-0 flex-1"><span class="flex items-center gap-1 truncate font-semibold"><span class="truncate">Crafting Table</span></span><span class="block truncate text-[10px] text-muted">Hand · craftable 55 from 1 log</span></span></button><button type="button" data-entry="furnace" data-tier="workbench" data-unlocked="true" title="Made: craft Furnace from Cobblestone" class="flex min-w-0 items-center gap-1.5 rounded-md border px-1.5 py-1 text-left text-[11px] border-border bg-surface-2 hover:border-border-strong"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 20px; height: 20px;" title="Furnace" aria-label="Furnace">Fu</span><span class="min-w-0 flex-1"><span class="flex items-center gap-1 truncate font-semibold"><span class="truncate">Furnace</span></span><span class="block truncate text-[10px] text-muted">Workbench · craftable 16 from 8 cobblestone</span></span></button></div></section></div>",
  "lava Storage": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="false" title="Drag over chests: every chest in the area becomes storage" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive size-4 size-5" aria-hidden="true"><rect width="20" height="5" x="2" y="3" rx="1"></rect><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M10 12h4"></path></svg><span class="text-center">Register chests</span></button><p class="w-56 text-[11px] leading-snug text-muted">Loot lives in chests. Drag over chests to register them, then click one (or box-select several) to choose what it keeps and how much it matters.</p></div></section><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto max-h-[46vh] w-[22rem] overflow-auto p-2" aria-label="Placeables" data-testid="architect-palette"><div class="grid grid-cols-2 gap-1"><button type="button" data-entry="chest" data-tier="workbench" data-unlocked="true" title="Made: craft Chest from Log" class="flex min-w-0 items-center gap-1.5 rounded-md border px-1.5 py-1 text-left text-[11px] border-border bg-surface-2 hover:border-border-strong"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 20px; height: 20px;" title="Chest" aria-label="Chest">Ch</span><span class="min-w-0 flex-1"><span class="flex items-center gap-1 truncate font-semibold"><span class="truncate">Chest</span></span><span class="block truncate text-[10px] text-muted">Workbench · craftable 27 from 2 log</span></span></button></div></section></div>",
