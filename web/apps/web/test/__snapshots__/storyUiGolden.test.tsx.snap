4"></path></svg></button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-6 px-1.5 text-danger" aria-label="Delete Camp"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2 size-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></li></ul></div><form class="space-y-2 rounded-md border border-border p-2" aria-label="Found a colony"><div class="font-semibold">Found a colony</div><div class="flex items-center gap-2"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-7 text-xs" aria-label="Colony name" maxlength="40" value="Hollow"><div class="flex items-center gap-1 whitespace-nowrap" role="group" aria-label="Pawns"><span>Pawns</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="Fewer pawns">−</button><output aria-label="Number of pawns" aria-live="polite" class="min-w-[2ch] text-center text-sm font-semibold tabular-nums text-fg">4</output><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none di