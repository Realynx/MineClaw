exports[`ColonyPanel > every state 1`] = `
{
  "crowd": "<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto w-[26rem] space-y-3 p-3 text-xs" aria-label="Colony" data-testid="colony-panel"><div><div class="mb-1 font-semibold">Colonies</div><ul class="space-y-1"><li><button type="button" aria-pressed="true" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-accent bg-accent-soft"><span class="font-semibold">Golden</span><span class="text-muted">2 pawns</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-border hover:bg-surface-2"><span class="font-semibold">Old</span><span class="text-muted">released</span><span class="ml-auto text-warn">paused</span></button></li></ul></div><div class="flex gap-2"><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause colony</button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md">Release pawns</button></div><div class="text-muted" data-testid="colony-seats">18 of 40 pawns in game — <span class="text-warn" data-testid="colony-seats-reason">server full (20 slots, 2 kept for poofimafox and kiwi)</span> · memory: room for 9 more</div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="colony-home"><div class="flex items-center gap-2"><span class="font-semibold">Home</span><span class="text-muted tabular-nums">0, 0</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto" title="Click the spot on the map"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-3.5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>Set home on the map</button><button type="button" disabled="" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house lucide-home size-3.5" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Move home here (migrate)</button></div><p class="text-[10.5px] text-subtle">Here is the map centre. Pawns far from the new home are brought to it.</p></div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="houses"><div class="flex items-center gap-2"><span class="font-semibold">Houses</span><span class="text-muted">home areas</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Draw a house</button></div><ul class="space-y-1"><li class="flex flex-wrap items-center gap-1.5" data-zone="z141"><button type="button" class="min-w-0 flex-1 truncate text-left font-medium hover:underline" title="Show on the map">Camp</button><span class="text-subtle tabular-nums" data-testid="zone-cells">128 cells</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-6 px-1.5" aria-label="Rename Camp"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pencil size-3.5" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path><path d="m15 5 4 4"></path></svg></button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-6 px-1.5 text-danger" aria-label="Delete Camp"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash lucide-trash-2 size-3.5" aria-hidden="true"><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M3 6h18"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button></li></ul></div><form class="space-y-2 rounded-md border border-border p-2" aria-label="Found a colony"><div class="font-semibold">Found a colony</div><div class="flex items-center gap-2"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-7 text-xs" aria-label="Colony name" maxlength="40" value="Hollow"><div class="flex items-center gap-1 whitespace-nowrap" role="group" aria-label="Pawns"><span>Pawns</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="Fewer pawns">−</button><output aria-label="Number of pawns" aria-live="polite" class="min-w-[2ch] text-center text-sm font-semibold tabular-nums text-fg">4</output><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="More pawns" title="More pawns (Shift: 10 more)">+</button></div></div><p class="text-[10.5px] text-muted" data-testid="settle-at">Settles at the map centre.</p><p class="text-[10.5px] text-subtle">Pawns are script-only bodies running the colony script. Any number: as many as the server's seats and memory allow come now, the rest join as room frees up.</p><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-accent text-accent-fg hover:bg-accent-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md">Found colony</button></form></section>",
  "founded": "<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto w-[26rem] space-y-3 p-3 text-xs" aria-label="Colony" data-testid="colony-panel"><div><div class="mb-1 font-semibold">Colonies</div><ul class="space-y-1"><li><button type="button" aria-pressed="true" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-accent bg-accent-soft"><span class="font-semibold">Golden</span><span class="text-muted">2 pawns</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-border hover:bg-surface-2"><span class="font-semibold">Old</span><span class="text-muted">released</span><span class="ml-auto text-warn">paused</span></button></li></ul></div><div class="flex gap-2"><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause colony</button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md">Release pawns</button></div><div class="space-y-1" data-testid="colony-options"><label class="flex items-center gap-2" title="A build that needs a crafting table or furnace the colony hasn't got: a pawn crafts one and places it near home"><input type="checkbox" checked="">Builds may place the benches they need</label><label class="flex items-center gap-2" title="Off: only benches you designate (inspector: Use as colony workbench) are used, never another player's"><input type="checkbox">Use any bench near home (no designation)</label><label class="flex items-center gap-2" title="Loot no chest's filter takes goes into any chest with room that doesn't deny it"><input type="checkbox" checked="">Unfiltered storage takes anything</label><label class="flex items-center gap-2" title="Off (like the genre): what a chest's filter no longer allows and no chest takes is dropped beside it"><input type="checkbox">Keep disallowed items until a chest takes them</label><label class="flex items-center gap-2" title="Last resort for a pawn stuck in a pit or a cave: teleport it home (op)"><input type="checkbox" checked="">Teleport stuck pawns home</label><label class="flex items-center gap-2" title="With nothing to do, in free hours and while resting after failures: pastimes (wander, socialise, stargaze, sit, the garden, the sunset), strolls only, or stay put">Idle pawns<select aria-label="Idle pawns" data-testid="colony-idle" class="rounded border border-border bg-surface px-1 py-0.5"><option value="recreation">recreation</option><option value="wander">wander</option><option value="stay">stay put</option></select></label></div><div class="text-muted" data-testid="colony-seats">4 of 4 pawns in game · server: 6 seats free, 2 kept for regulars</div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="colony-home"><div class="flex items-center gap-2"><span class="font-semibold">Home</span><span class="text-muted tabular-nums">0, 0</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto" title="Click the spot on the map"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-3.5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>Set home on the map</button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house lucide-home size-3.5" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Move home here (migrate)</button></div><p class="text-[10.5px] text-subtle">Here is 3, -2: the map centre. Pawns far from the new home are brought to it.</p></div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="houses"><div class="flex items-center gap-2"><span class="font-semibold">Houses</span><span class="text-muted">home areas</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Draw a house</button></div><p class="text-[10.5px] text-subtle">No houses yet: draw home areas where the pawns should sleep and rest.</p></div><form class="space-y-2 rounded-md border border-border p-2" aria-label="Found a colony"><div class="font-semibold">Found a colony</div><div class="flex items-center gap-2"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-7 text-xs" aria-label="Colony name" maxlength="40" value="Hollow"><div class="flex items-center gap-1 whitespace-nowrap" role="group" aria-label="Pawns"><span>Pawns</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="Fewer pawns">−</button><output aria-label="Number of pawns" aria-live="polite" class="min-w-[2ch] text-center text-sm font-semibold tabular-nums text-fg">4</output><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="More pawns" title="More pawns (Shift: 10 more)">+</button></div></div><p class="text-[10.5px] text-muted" data-testid="settle-at">Settles at <span class="font-semibold tabular-nums text-fg">3, -2</span>: the map centre. Pan to settle elsewhere.</p><p class="text-[10.5px] text-subtle">Pawns are script-only bodies running the colony script. Any number: as many as the server's seats and memory allow come now, the rest join as room frees up.</p><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-accent text-accent-fg hover:bg-accent-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md">Found colony</button></form></section>",
