"24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw size-4 size-5" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg><span class="text-center">Retry failed</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">O</span></button><button type="button" aria-pressed="false" title="Pawns leave these items and doors alone" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban size-4 size-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M4.929 4.929 19.07 19.071"></path></svg><span class="text-center">Forbid</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">F</span></button><button type="button" aria-pressed="false" title="Undo a forbid" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-4 size-5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-center">Allow</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">J</span></button></div></section></div>",
  "quarry": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="false" title="Pawns plant, tend and harvest here (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Growing zone</span></button><button type="button" aria-pressed="false" title="Trees here are cut and replanted (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Woodlot</span></button><button type="button" aria-pressed="true" title="Pawns dig everything down to bedrock (a spiral stair), or only the ores (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-accent bg-accent-soft text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Quarry</span></button><button type="button" aria-pressed="false" title="Pawns fish here with rods (still water only) (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Fishing zone</span></button><button type="button" aria-pressed="false" title="Loot goes here while the colony has no storage (replaces other work zones)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Drop spot</span></button><button type="button" aria-pressed="false" title="Where pawns rest and keep things tidy (an overlay layer)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Home area</span></button><button type="button" aria-pressed="false" title="Pawns never walk here (an overlay layer)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-dashed lucide-box-select size-4 size-5" aria-hidden="true"><path d="M5 3a2 2 0 0 0-2 2"></path><path d="M19 3a2 2 0 0 1 2 2"></path><path d="M21 19a2 2 0 0 1-2 2"></path><path d="M5 21a2 2 0 0 1-2-2"></path><path d="M9 3h1"></path><path d="M9 21h1"></path><path d="M14 3h1"></path><path d="M14 21h1"></path><path d="M3 9v1"></path><path d="M21 9v1"></path><path d="M3 14v1"></path><path d="M21 14v1"></path></svg><span class="text-center">Keep out</span></button><button type="button" aria-pressed="false" title="Drag over zones to erase those cells (empty zones go, a zone cut in two becomes two)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-4 size-5" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-center">Erase zone</span></button><div class="w-full" data-testid="quarry-mode"><div class="mb-1 text-[11px] font-semibold text-muted">Quarry</div><div class="flex flex-wrap gap-1" role="radiogroup" aria-label="Quarry mode"><button type="button" role="radio" aria-checked="true" title="Dig everything down to bedrock, leaving a spiral stair along the edge (2×2 at least)" class="rounded border px-1.5 py-0.5 text-[11px] border-accent bg-accent-soft text-fg">Quarry (everything)</button><button type="button" role="radio" aria-checked="false" title="Mine only the ores in the zone (the old mine zone)" class="rounded border px-1.5 py-0.5 text-[11px] border-border text-muted hover:text-fg">Ores only</button></div></div><p class="w-full text-[11px] leading-snug text-muted">Drag to paint. Cells touching a zone of the same type join it; work zones replace each other; Home area and Keep out are overlay layers. Shift-drag from inside a zone extends that zone.</p></div></section></div>",
  "select": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="false" title="Fell every tree in the area (whole trees)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-axe size-4 size-5" aria-hidden="true"><path d="m14 12-8.381 8.38a1 1 0 0 1-3.001-3L11 9"></path><path d="M15 15.5a.5.5 0 0 0 .5.5A6.5 6.5 0 0 0 22 9.5a.5.5 0 0 0-.5-.5h-1.672a2 2 0 0 1-1.414-.586l-5.062-5.062a1.205 1.205 0 0 0-1.704 0L9.352 5.648a1.205 1.205 0 0 0 0 1.704l5.062 5.062A2 2 0 0 1 15 13.828z"></path></svg><span class="text-center">Chop wood</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">C</span></button><button type="button" aria-pressed="false" title="Clear tall grass, flowers, ferns, saplings" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scissors size-4 size-5" aria-hidden="true"><circle cx="6" cy="6" r="3"></circle><path d="M8.12 8.12 12 12"></path><path d="M20 4 8.12 15.88"></path><circle cx="6" cy="18" r="3"></circle><path d="M14.8 14.8 20 20"></path></svg><span class="text-center">Cut plants</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">G</span></button><button type="button" aria-pressed="false" title="Ripe crops, melons, pumpkins, cane (replanted)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wheat size-4 size-5" aria-hidden="true"><path d="M2 22 16 8"></path><path d="M3.47 12.53 5 11l1.53 1.53a3.5 3.5 0 0 1 0 4.94L5 19l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"></path><path d="M7.47 8.53 9 7l1.53 1.53a3.5 3.5 0 0 1 0 4.94L9 15l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"></path><path d="M11.47 4.53 13 3l1.53 1.53a3.5 3.5 0 0 1 0 4.94L13 11l-1.53-1.53a3.5 3.5 0 0 1 0-4.94Z"></path><path d="M20 2h2v2a4 4 0 0 1-4 4h-2V6a4 4 0 0 1 4-4Z"></path><path d="M11.47 17.47 13 19l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L5 19l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"></path><path d="M15.47 13.47 17 15l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L9 15l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"></path><path d="M19.47 9.47 21 11l-1.53 1.53a3.5 3.5 0 0 1-4.94 0L13 11l1.53-1.53a3.5 3.5 0 0 1 4.94 0Z"></path></svg><span class="text-center">Harvest</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">H</span></button><button type="button" aria-pressed="false" title="Blocks at this level (filter on the options bar)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pickaxe size-4 size-5" aria-hidden="true"><path d="m14 13-8.381 8.38a1 1 0 0 1-3.001-3L11 9.999"></path><path d="M15.973 4.027A13 13 0 0 0 5.902 2.373c-1.398.342-1.092 2.158.277 2.601a19.9 19.9 0 0 1 5.822 3.024"></path><path d="M16.001 11.999a19.9 19.9 0 0 1 3.024 5.824c.444 1.369 2.26 1.676 2.603.278A13 13 0 0 0 20 8.069"></path><path d="M18.352 3.352a1.205 1.205 0 0 0-1.704 0l-5.296 5.296a1.205 1.205 0 0 0 0 1.704l2.296 2.296a1.205 1.205 0 0 0 1.704 0l5.296-5.296a1.205 1.205 0 0 0 0-1.704z"></path></svg><span class="text-center">Mine</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">M</span></button><button type="button" aria-pressed="false" title="Carry every dropped item to storage" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hand-grab lucide-grab size-4 size-5" aria-hidden="true"><path d="M18 11.5V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v1.4"></path><path d="M14 10V8a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"></path><path d="M10 9.9V9a2 2 0 0 0-2-2a2 2 0 0 0-2 2v5"></path><path d="M6 14a2 2 0 0 0-2-2a2 2 0 0 0-2 2"></path><path d="M18 11a2 2 0 1 1 4 0v3a8 8 0 0 1-8 8h-4a8 8 0 0 1-8-8 2 2 0 1 1 4 0"></path></svg><span class="text-center">Haul</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">L</span></button><button type="button" aria-pressed="false" title="Hunt the animals in the area" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-crosshair size-4 size-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="22" x2="18" y1="12" y2="12"></line><line x1="6" x2="2" y1="12" y2="12"></line><line x1="12" x2="12" y1="6" y2="2"></line><line x1="12" x2="12" y1="22" y2="18"></line></svg><span class="text-center">Hunt</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">N</span></button><button type="button" aria-pressed="false" title="Take apart placed blocks" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hammer size-4 size-5" aria-hidden="true"><path d="m15 12-9.373 9.373a1 1 0 0 1-3.001-3L12 9"></path><path d="m18 15 4-4"></path><path d="m21.5 11.5-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"></path></svg><span class="text-center">Deconstruct</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">K</span></button><button type="button" aria-pressed="false" title="Remove designations in the area" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x size-4 size-5" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg><span class="text-center">Cancel</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">Z</span></button><button type="button" aria-pressed="false" title="Try failed or resting designations and failed build cells in the area again now" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rotate-cw size-4 size-5" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path></svg><span class="text-center">Retry failed</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">O</span></button><button type="button" aria-pressed="false" title="Pawns leave these items and doors alone" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-ban size-4 size-5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M4.929 4.929 19.07 19.071"></path></svg><span class="text-center">Forbid</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">F</span></button><button type="button" aria-pressed="false" title="Undo a forbid" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check size-4 size-5" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg><span class="text-center">Allow</span><span class="absolute top-0.5 right-1 font-mono text-[9px] text-subtle">J</span></button></div></section></div>",
  "storage": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="true" title="Drag over chests: every chest in the area becomes storage" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-accent bg-accent-soft text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-archive size-4 size-5" aria-hidden="true"><rect width="20" height="5" x="2" y="3" rx="1"></rect><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"></path><path d="M10 12h4"></path></svg><span class="text-center">Register chests</span></button><p class="w-56 text-[11px] leading-snug text-muted">Loot lives in chests. Drag over chests to register them, then click one (or box-select several) to choose what it keeps and how much it matters.</p></div></section><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto max-h-[46vh] w-[22rem] overflow-auto p-2" aria-label="Placeables" data-testid="architect-palette"><div class="grid grid-cols-2 gap-1"><button type="button" data-entry="chest" data-tier="workbench" data-unlocked="true" title="Made: craft Chest from Log" class="flex min-w-0 items-center gap-1.5 rounded-md border px-1.5 py-1 text-left text-[11px] border-border bg-surface-2 hover:border-border-strong"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 20px; height: 20px;" title="Chest" aria-label="Chest">Ch</span><span class="min-w-0 flex-1"><span class="flex items-center gap-1 truncate font-semibold"><span class="truncate">Chest</span></span><span class="block truncate text-[10px] text-muted">Workbench · craftable 27 from 2 log</span></span></button></div></section></div>",
  "wall": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="true" title="Drag a rectangle (Alt: a straight line)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-accent bg-accent-soft text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 