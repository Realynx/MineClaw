exports[`ColonyPanel > renaming a house 1`] = `"<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto w-[26rem] space-y-3 p-3 text-xs" aria-label="Colony" data-testid="colony-panel"><div><div class="mb-1 font-semibold">Colonies</div><ul class="space-y-1"><li><button type="button" aria-pressed="true" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-accent bg-accent-soft"><span class="font-semibold">Golden</span><span class="text-muted">2 pawns</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-border hover:bg-surface-2"><span class="font-semibold">Old</span><span class="text-muted">released</span><span class="ml-auto text-warn">paused</span></button></li></ul></div><div class="flex gap-2"><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause colony</button><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md">Release pawns</button></div><div class="text-muted" data-testid="colony-seats">3 of 4 pawns in game · server: 0 seats free, 1 kept for regulars</div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="colony-home"><div class="flex items-center gap-2"><span class="font-semibold">Home</span><span class="text-muted tabular-nums">0, 0</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto" title="Click the spot on the map"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin size-3.5" aria-hidden="true"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>Set home on the map</button><button type="button" disabled="" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-house lucide-home size-3.5" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Move home here (migrate)</button></div><p class="text-[10.5px] text-subtle">Here is the map centre. Pawns far from the new home are brought to it.</p></div><div class="space-y-1.5 rounded-md border border-border p-2" data-testid="houses"><div class="flex items-center gap-2"><span class="font-semibold">Houses</span><span class="text-muted">home areas</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md ml-auto"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus size-3.5" aria-hidden="true"><path d="M5 12h14"></path><path d="M12 5v14"></path></svg>Draw a house</button></div><ul class="space-y-1"><li class="flex items-center gap-1.5" data-zone="z141"><form class="flex min-w-0 flex-1 gap-1"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-6 text-xs" aria-label="Name of Camp" maxlength="40" value="Camp"><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md h-6">Save</button></form></li></ul></div><form class="space-y-2 rounded-md border border-border p-2" aria-label="Found a colony"><div class="font-semibold">Found a colony</div><div class="flex items-center gap-2"><input class="rounded-lg border border-border bg-surface px-3 text-sm text-fg placeholder:text-subtle transition-colors hover:border-border-strong focus:border-accent focus:outline-none focus:ring-2 focus:ring-[var(--ring)] disabled:opacity-60 h-9 w-full h-7 text-xs" aria-label="Colony name" maxlength="40" value="Hollow"><div class="flex items-center gap-1 whitespace-nowrap" role="group" aria-label="Pawns"><span>Pawns</span><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="Fewer pawns">−</button><output aria-label="Number of pawns" aria-live="polite" class="min-w-[2ch] text-center text-sm font-semibold tabular-nums text-fg">4</output><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md h-7 w-7 px-0" aria-label="More pawns">+</button></div></div><p class="text-[10.5px] text-muted" data-testid="settle-at">Settles at the map centre.</p><p class="text-[10.5px] text-subtle">Pawns are script-only bodies running the colony script.</p><button type="submit" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-accent text-accent-fg hover:bg-accent-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md">Found colony</button></form></section>"`;

exports[`MaterialBar > every tool, wide 1`] = `
