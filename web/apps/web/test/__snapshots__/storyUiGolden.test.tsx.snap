  "storage": "<div class="flex items-end gap-2"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex w-[34rem] gap-2 p-2" aria-label="Architect" data-testid="architect"><div class="flex w-24 flex-col gap-0.5"><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Orders</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Zones</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Structure</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Furniture</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Production</button><button type="button" aria-pressed="true" class="rounded px-2 py-1.5 text-left text-xs font-semibold bg-accent-soft text-fg">Storage</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Lighting</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Water</button><button type="button" aria-pressed="false" class="rounded px-2 py-1.5 text-left text-xs font-semibold text-muted hover:bg-surface-2">Misc</button></div><div class="flex flex-1 flex-wrap content-start gap-1.5"><button type="button" aria-pressed="true" title="Drag over chests: every chest in the area becomes storage" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-accent bg-accent-soft text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height=