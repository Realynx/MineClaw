  "block": "<div class="pointer-events-none relative max-w-full"><section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto flex max-w-full items-center gap-2 px-2 py-1.5 text-xs" role="toolbar" aria-label="Single block: material and options" data-testid="material-bar" data-docked="bottom-left"><span class="flex shrink-0 items-center gap-1.5" title="Click, or drag a box; Q/E turns a block that faces"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="size-4 size-4 text-accent" aria-hidden="true"><path d="M12 3 4 7.5v9L12 21l8-4.5v-9L12 3Z"></path><path d="M4 7.5 12 12l8-4.5M12 12v9"></path></svg><span class="font-semibold whitespace-nowrap">Single block</span></span><span class="h-6 w-px shrink-0 bg-border" aria-hidden="true"></span><label class="flex h-7 shrink-0 items-center gap-1 rounded border border-border bg-surface-2 px-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search size-3 text-muted" aria-hidden="true"><path d="m21 21-4.34-4.34"></path><circle cx="11" cy="11" r="8"></circle></svg><input placeholder="Material" aria-label="Search materials" class="w-20 bg-transparent text-[11px] outline-none placeholder:text-subtle" value=""></label><span class="flex shrink-0 items-center gap-1" aria-label="Recent materials" data-testid="recent-materials"><button type="button" data-recent="5:0" data-unlocked="true" aria-pressed="false" title="Oak Planks · Hand · have 96 · key 1" class="relative flex shrink-0 items-center gap-1.5 rounded-md border text-left h-7 px-1 border-border bg-surface-2 hover:border-border-strong"><span class="inline-grid shrink-0 place-items-center rounded-sm bg-surface-3 text-[9px] font-semibold text-muted" style="width: 18px; height: 18px;" title="Planks" aria-label="Planks">Pl</span><span cl