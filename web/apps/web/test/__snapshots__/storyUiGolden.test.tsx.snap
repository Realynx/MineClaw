w.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-door-open size-4 size-5" aria-hidden="true"><path d="M10 21H2"></path><path d="M10 3H7a2 2 0 00-2 2v16"></path><path d="M14 12h.01"></path><path d="M19 21V5a2 2 0 00-1.675-1.974l-6.163-1.013A1 1 0 0010 3v18a1 1 0 001.124.992z"></path><path d="M22 21h-3"></path></svg><span class="text-center">Door</span></button><button type="button" aria-pressed="false" title="Click wall cells (drag for a row)" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-app-window size-4 size-5" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M10 4v4"></path><path d="M2 8h20"></path><path d="M6 4v4"></path></svg><span class="text-center">Window</span></button><button type="button" aria-pressed="false" title="Drag a run; Q/E turns" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leading-tight font-medium border-border bg-surface-2 text-muted hover:border-border-strong hover:text-fg"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 size-5" aria-hidden="true"><path d="M3 20h5v-5h5v-5h5V5h3"></path><path d="M3 20h18" opacity=".5"></path></svg><span class="text-center">Stairs</span></button><button type="button" aria-pressed="false" title="Drag a rectangle" class="relative flex h-[62px] w-[74px] flex-col items-center justify-center gap-1 rounded-md border text-[11px] leadin