  "noneOnline": "<section class="rounded-lg border border-border bg-surface/95 text-fg shadow-pop pointer-events-auto w-[26rem] space-y-3 p-3 text-xs" aria-label="Colony" data-testid="colony-panel"><div><div class="mb-1 font-semibold">Colonies</div><ul class="space-y-1"><li><button type="button" aria-pressed="true" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-accent bg-accent-soft"><span class="font-semibold">Golden</span><span class="text-muted">2 pawns</span></button></li><li><button type="button" aria-pressed="false" class="flex w-full items-center gap-2 rounded border px-2 py-1 text-left border-border hover:bg-surface-2"><span class="font-semibold">Old</span><span class="text-muted">released</span><span class="ml-auto text-warn">paused</span></button></li></ul></div><div class="flex gap-2"><button type="button" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 bg-surface border border-border text-fg hover:bg-surface-2 hover:border-border-strong shadow-card h-7 px-2.5 text-xs gap-1.5 rounded-md"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause size-3.5" aria-hidden="true"><rect x="14" y="3" width="5" height="18" rx="1"></rect><rect x="5" y="3" width="5" height="18" rx="1"></rect></svg>Pause colony</button><button type="button" disabled="" class="inline-flex shrink-0 items-center font-medium whitespace-nowrap transition-colors select-none disabled:pointer-events-none disabled:opacity-50 text-muted hover:text-fg hover:bg-surface-2 h-7 px-2.5 text-xs gap-1.5 rounded-md">Release pawns</button></div><div class="text-muted" data-testid="colony-seats">3 of 4 pawns in game · server: 0 seats free, 1 kept for regulars</div><div class="space-y-1.5 rounded-md border border-border p-2" d