{
  "name": "@mineclaw/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS gateway of the MineClaw Web Explorer: auth, sessions, CSRF, RBAC, audit, the signed bridge client, SSE fan-out and the prod reverse proxy to Next. See docs/web/architecture.md and docs/web/api.md.",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --disable-warning=ExperimentalWarning dist/main.js --dev",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "users": "node --disable-warning=ExperimentalWarning dist/cli/users.js"
  },
  "dependencies": {
    "@mineclaw/contracts": "0.1.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "busboy": "1.6.0",
    "helmet": "8.3.0",
    "http-proxy-middleware": "4.2.0",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.5",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
