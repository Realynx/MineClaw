{
  "name": "@mineclaw/world-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Browser voxel world viewer for MineClaw hives (three.js React component): MCWC chunks, entities, overlays.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "ATLAS.md",
    "assets",
    "generated"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:extract": "node scripts/extract-assets.mjs --find",
    "assets:pack": "node scripts/pack-assets.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "three": ">=0.160.0"
  },
  "dependencies": {
    "pako": "3.0.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
